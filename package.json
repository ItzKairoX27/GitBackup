{
  "name": "gitbackup",
  "type": "module",
  "version": "1.0.0",
  "description": "Desktop app for backing up GitHub repositories to local storage",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "preview": "vite preview",
    "package": "tauri build",
    "package:mac": "tauri build --target aarch64-apple-darwin",
    "package:win": "tauri build --target x86_64-pc-windows-msvc",
    "package:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "author": "ItzKairoX27",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ItzKairoX27/gitbackup"
  },
  "homepage": "https://github.com/ItzKairoX27/gitbackup",
  "engines": {
    "bun": ">=1.0"
  },
  "engineStrict": true,
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-store": "^2.4.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.10"
  }
}
